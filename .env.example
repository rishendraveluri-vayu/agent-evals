# Copy to .env and fill in what you need. This file holds names only; values
# live in your local .env, which is never committed.

# Local infrastructure. Leave blank to use the local-only defaults in
# docker-compose.yml (services bind to 127.0.0.1 only).
POSTGRES_PASSWORD=
# Must start with "sk-". Only LiteLLM and the API hold it; workers never do.
LITELLM_MASTER_KEY=
# Shared secret workers send to the API (Authorization: Bearer) on /api/worker/*. The API and
# every worker read this one variable, with one default when it is blank.
EVALS_WORKER_TOKEN=
# The platform git commit recorded on every experiment, e.g. `git rev-parse HEAD`.
EVALS_PLATFORM_COMMIT=
# The most, in USD, that pre-run conflict checks may spend in all (each is a real call to
# Claude Sonnet 5.5). Blank means 2. Raise it only if you mean to spend more on them.
EVALS_CONFLICT_CHECK_ALLOWANCE_USD=
# Host ports, all bound to 127.0.0.1. Change one if it is already in use.
UI_PORT=
API_PORT=
LITELLM_PORT=

# Model providers. Needed only to run agents on real models, which costs money: every run shows
# its trials, models and most it can cost, and asks you to confirm, before it starts. Without a
# key you can still build, save and preview agents, open the finished example, and run on fake
# models, which make the same scripted calls whatever the task, so most of their trials fail:
# they test the platform, not an agent. Tests and CI never use these keys.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
