{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evals.local/contract/v2/runner-report.schema.json",
  "title": "Runner report (contract v2)",
  "description": "What the runner adds to a trial, never the adapter (docs/adapter-contract.md sections 5 and 7): the label, the proxy's usage, the exit status and the full logs. Uploaded with result.json and trace.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "trial_id",
    "attempt",
    "harness",
    "label",
    "end_state",
    "adapter",
    "proxy_usage",
    "logs",
    "files",
    "timing"
  ],
  "properties": {
    "contract_version": {
      "const": "2"
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "harness": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "description": "agent: graded by end_state. infra:*: not a quality outcome; reported, never silently dropped. infra:config_error (D26): a harness_error whose LiteLLM status was 401, 403 or 404, or a 400 about the request setup (auth, an unknown model, a rejected parameter); never re-queued, and the experiment pauses. infra:provider_error: 429 or 5xx, re-queued once. infra:budget_net: a budget stop, never re-queued. infra:sim_error: the simulated client failed (result conversation.ended_by sim_error: its call failed, or its reply had no text), re-queued once.",
      "enum": [
        "agent",
        "infra:provider_error",
        "infra:config_error",
        "infra:sim_error",
        "infra:budget_net",
        "infra:adapter_crash",
        "infra:timeout_kill"
      ]
    },
    "end_state": {
      "description": "Copied from result.json; null when there is no valid result.",
      "type": [
        "string",
        "null"
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "signal",
        "result_valid",
        "result_errors",
        "trace_valid",
        "trace_errors",
        "leftover_processes"
      ],
      "properties": {
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "description": "Set when the runner killed the process group.",
          "type": [
            "string",
            "null"
          ]
        },
        "result_valid": {
          "type": "boolean"
        },
        "result_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trace_valid": {
          "type": "boolean"
        },
        "trace_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "leftover_processes": {
          "description": "Processes still alive in the group after the adapter exited, then killed.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "proxy_usage": {
      "description": "LiteLLM's records for the trial's key (R10.9). Null when the trial did not go through the proxy, such as a unit test against the fake directly.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "model_calls",
            "failed_calls",
            "input_tokens",
            "output_tokens",
            "cost_usd",
            "last_status"
          ],
          "properties": {
            "complete": {
              "description": "False if LiteLLM's log still held fewer calls than the harness reported after the runner's wait. Such a trial's counts and cost are not trusted.",
              "type": "boolean"
            },
            "model_calls": {
              "type": "integer",
              "minimum": 0
            },
            "failed_calls": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "last_status": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr"
      ],
      "properties": {
        "stdout": {
          "$ref": "#/$defs/log"
        },
        "stderr": {
          "$ref": "#/$defs/log"
        }
      }
    },
    "files": {
      "description": "Every file under /trial/out, for the upload manifest (section 10).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "ended_at",
        "wall_s",
        "safety_net_s"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "wall_s": {
          "type": "number",
          "minimum": 0
        },
        "safety_net_s": {
          "description": "timeout_s x 1.5 + 30 (D23).",
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "$defs": {
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "truncated"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "truncated": {
          "description": "True only if the log passed the 50 MB cap (section 10).",
          "type": "boolean"
        }
      }
    }
  }
}
