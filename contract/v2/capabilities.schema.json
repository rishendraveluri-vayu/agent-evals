{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evals.local/contract/v2/capabilities.schema.json",
  "title": "Harness capabilities (contract v2)",
  "description": "One per harness, committed next to its adapter. The probe command writes the supported, native, default and evidence fields from what it captured; only what a request cannot show is declared by hand. See docs/adapter-contract.md section 4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "harness", "version", "model_api_formats", "settings", "harness_options_schema", "known_differences"],
  "properties": {
    "contract_version": {"const": "2"},
    "harness": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "ref"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "model_api_formats": {"type": "array", "minItems": 1, "items": {"enum": ["openai_chat", "anthropic_messages"]}, "uniqueItems": true},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "max_output_tokens", "max_steps", "timeout_s", "parallel_tool_calls", "memory", "skills", "compression"],
      "properties": {
        "temperature": {"$ref": "#/$defs/setting"},
        "max_output_tokens": {"$ref": "#/$defs/setting"},
        "max_steps": {"$ref": "#/$defs/setting"},
        "timeout_s": {"$ref": "#/$defs/setting"},
        "parallel_tool_calls": {"$ref": "#/$defs/setting"},
        "memory": {"$ref": "#/$defs/setting"},
        "skills": {"$ref": "#/$defs/setting"},
        "compression": {"$ref": "#/$defs/setting"}
      }
    },
    "harness_options_schema": {"description": "A JSON Schema for spec.harness_options.", "type": "object"},
    "known_differences": {"description": "Feeds the invariance diff (D20).", "type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "evidence"],
      "properties": {
        "supported": {"type": "boolean"},
        "native": {"description": "Where the adapter puts the value in the harness.", "type": "string"},
        "default": {"description": "The harness's own value when the platform sets none. Null if it sends nothing."},
        "evidence": {"description": "probe:<date> (written by the probe command), declared:<reason> (by hand), or none.", "type": "string", "pattern": "^(probe:\\d{4}-\\d{2}-\\d{2}|declared:.+|none)$"},
        "extra_calls_at_limit": {"description": "Model calls the harness makes beyond max_steps when it stops at the limit.", "type": "integer", "minimum": 0},
        "observed": {"description": "What the probe saw, for a reader.", "type": "string"},
        "effect": {
          "description": "D24 effect checks, per model. Absent until run.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "evidence"],
            "properties": {
              "status": {"enum": ["effective", "inert", "not_checked"]},
              "evidence": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
